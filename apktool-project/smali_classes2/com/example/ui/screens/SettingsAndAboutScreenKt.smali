47 \u0627\u0633\u062a. \u062f\u0631 \u0641\u0631\u0622\u06cc\u0646\u062f \u062a\u0648\u0644\u06cc\u062f \u0628\u0631\u062e\u06cc \u0627\u0632 \u0645\u0637\u0627\u0644\u0628 \u0627\u0632 \u0627\u0628\u0632\u0627\u0631\u0647\u0627\u06cc \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u062f\u0633\u062a\u06cc\u0627\u0631 \u0646\u06af\u0627\u0631\u0634\u060c \u0627\u06cc\u062f\u0647\u200c\u067e\u0631\u062f\u0627\u0632\u06cc \u0648 \u0628\u0647\u0628\u0648\u062f \u0645\u062d\u062a\u0648\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a. \u0645\u0637\u0627\u0644\u0628 \u0627\u0631\u0627\u0626\u0647\u200c\u0634\u062f\u0647 \u062d\u0627\u0635\u0644 \u062a\u0623\u0644\u06cc\u0641 \u0648 \u067e\u0631\u062f\u0627\u0632\u0634 \u0645\u0624\u0644\u0641 \u0628\u0648\u062f\u0647 \u0648 \u0627\u0632 \u0645\u0646\u0627\u0628\u0639 \u062f\u06cc\u06af\u0631 \u0628\u0647 \u0635\u0648\u0631\u062a \u0645\u0633\u062a\u0642\u06cc\u0645 \u06a9\u067e\u06cc\u200c\u0628\u0631\u062f\u0627\u0631\u06cc \u0646\u0634\u062f\u0647\u200c\u0627\u0646\u062f.\n\n\u0645\u0646\u0627\u0628\u0639:\n\u2022 https://gemini.google.com/\n\u2022 https://chatgpt.com/"

